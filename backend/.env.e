# Puerto del servidor
PORT=4000

# Directorio de destino en Linux donde se depositarán los archivos CSV
# En servidor Linux, por ejemplo: /var/data/barcodes
# En desarrollo local: ./storage
STORAGE_DIR=./storage

# Configuración de CORS (permite la URL de Vercel de la app en producción o * para pruebas)
CORS_ORIGIN=*

# Entorno (development | production)
NODE_ENV=development
